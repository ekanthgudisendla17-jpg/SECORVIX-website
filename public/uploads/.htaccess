# Images uploaded from the blog dashboard. Only image files are served; nothing executes.
Options -Indexes -ExecCGI
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "(?i)\.(jpe?g|png|webp|gif)$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "(?i)\.(jpe?g|png|webp|gif)$">
    Allow from all
  </FilesMatch>
</IfModule>
