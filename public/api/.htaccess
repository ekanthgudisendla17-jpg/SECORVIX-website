# Only the public endpoints are reachable; helpers and the generated config are not.
Options -Indexes
<FilesMatch "^(_.*|config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
